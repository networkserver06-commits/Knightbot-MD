# Authentication / runtime
# Linking-code login is automatic for a new session; the bot prompts for the number.
PHONE_NUMBER=
PAIRING_NUMBER=
PAIRING_CODE=true
# Optional: set AUTH_METHOD=qr and PAIRING_CODE=false to use QR instead.
AUTH_METHOD=pairing
USE_MOBILE=false
AUTH_DIR=./session
BOT_MODE=public
PREFIX=.
# East Africa Time (EAT, commonly called EAC); IANA name is Africa/Nairobi.
TIME_ZONE=Africa/Nairobi

# Branding
BOT_NAME=LEE TECH BOT
BOT_OWNER=LEE TECH
OWNER_NUMBER=
CHANNEL_LINK=

# Optional provider keys (never commit real values)
GIPHY_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_MAX_TOKENS=180
AI_TEMPERATURE=0.7
XTEAM_API_KEY=
LOLHUMAN_API_KEY=
NEOXR_API_KEY=
VIOLETICS_API_KEY=
ZENZ_API_KEY=
FGMODS_API_KEY=

# Operational controls
LOG_LEVEL=info
COMMAND_RATE_LIMIT=8
COMMAND_RATE_WINDOW_MS=10000
NODE_ENV=production
